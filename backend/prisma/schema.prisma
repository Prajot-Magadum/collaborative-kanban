generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Board {
  id        String   @id @default(uuid())
  title     String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  lists     List[]
}

model List {
  id      String @id @default(uuid())
  title   String
  boardId String
  cards   Card[]
  board   Board  @relation(fields: [boardId], references: [id])
}

model Card {
  id          String    @id @default(uuid())
  title       String
  description String?
  priority    String?
  dueDate     DateTime?
  listId      String
  list        List      @relation(fields: [listId], references: [id])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  boards    Board[]
}
